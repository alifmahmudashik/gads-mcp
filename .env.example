# Copy these into Vercel -> your project -> Settings -> Environment Variables.
# (For local testing, copy this file to .env.local and fill it in. Never commit real values.)
# The README explains where to find every value, step by step.

# Public address of this app, no trailing slash.
# Use your Vercel address (https://<your-project>.vercel.app) or your own domain.
APP_URL=https://your-project.vercel.app

# Google OAuth client (Google Cloud -> APIs & Services -> Credentials -> Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the SECRET key (sb_secret_...), not the publishable key: RLS blocks the publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate with either:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Who may sign in: your Google email, a comma-separated list, or * for any Google account
ALLOWED_EMAILS=you@gmail.com

# Real changes are blocked unless this is exactly "true" (previews always work).
# Start with false, switch to true once you trust the setup.
ALLOW_WRITES=false

# Optional
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890   (only if manager auto-detection picks the wrong one)
# GOOGLE_ADS_API_VERSION=v26
