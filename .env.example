# Public address of this app (no trailing slash)
APP_URL=https://gads-mcp.alifmahmud.com

# Google OAuth client (Credentials -> your Web application client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Supabase (Project Settings -> API)
SUPABASE_URL=https://xwysnpxcvzlgrlupguaw.supabase.co
# Use the SECRET key (sb_secret_...), not the publishable key: RLS blocks the publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=

# Google accounts allowed to sign in: comma-separated list, or * for any account
ALLOWED_EMAILS=*

# Real changes are blocked unless this is exactly "true" (previews always work)
ALLOW_WRITES=true

# Optional
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_API_VERSION=v26
